# Copy this file to `.env` and fill in whatever you actually plan to use.
# Defaults below allow offline ingestion and prompt building with the official
# CVE records. Explicitly use manual + heuristic + hashing for the offline
# walkthrough if your environment already selects an API (see README section 4).

# ---- LLM backend used for attack-graph generation -----------------------
# "manual" (default): scripts/build_prompt.py just writes the prompt to a
#          file for you to paste into ChatGPT/Gemini/Claude/etc, and
#          scripts/ingest_response.py reads the pasted answer back in.
# "openai": scripts/build_prompt.py calls the OpenAI API automatically.
# "openrouter": calls OpenRouter; OPENROUTER_MODEL must be an exact model slug.
# "gemini": scripts/build_prompt.py calls the Gemini API automatically.
LLM_BACKEND=manual

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- CVE property extraction (Algorithm 1) -------------------------------
# "heuristic" (default): no API calls, uses structured CVE fields + regexes.
# "llm": follows the paper's extraction approach using LLM_BACKEND above for
#        ProductInfo/Platform/ProblemType from each CVE description.
EXTRACTOR_BACKEND=heuristic

# ---- Embeddings (Section 3.2 Retriever) ----------------------------------
# "hashing" (default): dependency-free, offline, good enough for demoing
#           the retriever's control flow.
# "sentence-transformers": paper-accurate facebook/contriever-msmarco
#           embeddings (requires `pip install -e ".[embeddings]"`).
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=facebook/contriever-msmarco

# ---- Retriever thresholds (Algorithm 2 defaults from the paper) ---------
MIN_SIMILARITY=0.68
CONTEXT_TOKENS_PER_QUERY=3750
